/* ============================================================
   LiveStreamFetcher Qt 版 — 全局样式表
   对齐 v8.2.8 截图：单栏布局 · 深色玻璃感 · 圆角仪表盘
   ============================================================ */

/* ---------- 全局基础 ---------- */
QWidget {
    background: transparent;
    color: #f0f4ff;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background: #15101e;   /* 深紫黑底（v8.2.8 风格） */
}

/* ---------- 窗口控制按钮 ---------- */
QPushButton#winCtrlBtn {
    background: transparent;
    color: #9aa3bd;
    border: 1px solid #2a3148;
    border-radius: 4px;
    font-size: 12px;
}
QPushButton#winCtrlBtn:hover { background: #1f1830; color: #f0f4ff; }

QPushButton#winCloseBtn {
    background: transparent;
    color: #9aa3bd;
    border: 1px solid #2a3148;
    border-radius: 4px;
    font-size: 11px;
}
QPushButton#winCloseBtn:hover { background: #ef4444; color: #ffffff; border: 1px solid #ef4444; }

QToolTip {
    background: #161b2e;
    color: #f0f4ff;
    border: 1px solid #2a3148;
    padding: 6px 10px;
    border-radius: 6px;
}

/* ---------- 平台 tab ---------- */
QPushButton#platformTab {
    background: transparent;
    color: #c0c8d8;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 13px;
    min-width: 80px;
}

QPushButton#platformTab:hover {
    background: #1f1830;
    color: #ffffff;
}

QPushButton#platformTab:checked {
    color: #ffffff;
    border: none;
    font-weight: bold;
}

/* 选中态：实心平台色背景（v8.2.8 风格） */
QPushButton#platformTab[platform="xhs"]:checked { background: #FF2442; }
QPushButton#platformTab[platform="dy"]:checked { background: #FE2C55; }
QPushButton#platformTab[platform="ks"]:checked { background: #FF6A00; }
QPushButton#platformTab[platform="tb"]:checked { background: #FF6A00; }
QPushButton#platformTab[platform="yy"]:checked { background: #FFD700; color: #1a1530; }

/* ---------- URL 输入 ---------- */
#urlInput {
    background: #1a1530;
    color: #f0f4ff;
    border: 1px solid #2a3148;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13px;
    selection-background-color: #FF6A00;
}

#urlInput:focus {
    border: 1px solid #FF6A00;
}

/* ---------- 6 个固定配色按钮 ---------- */
/* 获取流链接（金色渐变） */
QPushButton#fetchBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFE55C, stop:1 #FFD700);
    color: #1a1530;
    border: none;
    border-radius: 10px;
    padding: 8px 18px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#fetchBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFEE88, stop:1 #FFE055);
}
QPushButton#fetchBtn:pressed { background: #D4A017; }

/* HEVC 转码（紫色） */
QPushButton#transcodeTopBtn {
    background: #8b5cf6;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#transcodeTopBtn:hover { background: #a855f7; }
QPushButton#transcodeTopBtn:pressed { background: #7c3aed; }

/* 代理设置（蓝色） */
QPushButton#proxyBtn {
    background: #3b82f6;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#proxyBtn:hover { background: #4a90d9; }
QPushButton#proxyBtn:pressed { background: #2563eb; }

/* 复制全部（蓝色，描边） */
QPushButton#copyAllBtn {
    background: #1e88e5;
    color: #ffffff;
    border: 1px solid #2196f3;
    border-radius: 10px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#copyAllBtn:hover { background: #1976d2; }

/* 系统代理（青色/teal） */
QPushButton#sysProxyBtn {
    background: #00bcd4;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#sysProxyBtn:hover { background: #00acc1; }
QPushButton#sysProxyBtn:pressed { background: #0097a7; }

/* 视频号工具（绿色） */
QPushButton#wechatBtn {
    background: #07C160;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#wechatBtn:hover { background: #06ad56; }
QPushButton#wechatBtn:pressed { background: #059048; }

/* ---------- 结果区 ---------- */
#resultTitle {
    font-size: 14px;
    font-weight: bold;
    color: #f0f4ff;
    background: transparent;
}

/* spec 筛选 chip */
QPushButton#specChip {
    background: #1a1530;
    color: #c0c8d8;
    border: 1px solid #2a3148;
    border-radius: 14px;
    padding: 4px 14px;
    font-size: 12px;
    font-weight: bold;
}
QPushButton#specChip:checked {
    background: #1f1830;
    color: #00d4ff;
    border: 1px solid #00d4ff;
}
QPushButton#specChip:hover {
    background: #1f1830;
    color: #ffffff;
}

/* ---------- 流卡片（单行布局） ---------- */
#streamCard {
    background: #1a1530;
    border: 1px solid #2a3148;
    border-radius: 10px;
}
#streamCard:hover {
    background: #1f1830;
    border: 1px solid #3a3158;
}
#streamIndex { background: transparent; font-size: 12px; font-weight: bold; color: #6a7390; }
#streamQuality { background: transparent; font-size: 12px; font-weight: bold; }
#streamUrl { background: transparent; font-size: 11px; color: #8b949e; font-family: "Consolas", monospace; }
#streamHevcHint { background: transparent; font-size: 10px; color: #ef4444; }

QPushButton#copyBtn {
    background: #3b82f6;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: bold;
}
QPushButton#copyBtn:hover { background: #4a90d9; }

QPushButton#obsBtn {
    background: #ff5000;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: bold;
}
QPushButton#obsBtn:hover { background: #e64a00; }

QPushButton#transcodeBtn {
    background: #6b7280;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: bold;
}
QPushButton#transcodeBtn:hover { background: #9ca3af; }

/* ---------- 状态栏 ---------- */
#statusBar {
    background: transparent;
    border-top: 1px solid #1a1530;
}
#statusLogin { background: transparent; font-size: 11px; color: #9aa3bd; }
#statusVisit { background: transparent; font-size: 11px; color: #9aa3bd; }

/* ---------- 滚动条 ---------- */
QScrollArea { background: transparent; border: none; }
QScrollBar:vertical {
    background: transparent; width: 8px; margin: 2px;
}
QScrollBar::handle:vertical {
    background: #3a3158; border-radius: 4px; min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #4a4168; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: transparent; height: 8px; margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #3a3158; border-radius: 4px; min-width: 30px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------- 菜单 ---------- */
QMenu {
    background: #1a1530;
    color: #f0f4ff;
    border: 1px solid #2a3148;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 8px 24px;
    border-radius: 6px;
}
QMenu::item:selected { background: #1f1830; }
QMenu::separator { height: 1px; background: #2a3148; margin: 4px 8px; }
